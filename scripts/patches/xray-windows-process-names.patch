+package router
+
+import (
+	"runtime"
+	"testing"
+)
+
+func TestLevikWindowsProcessName(t *testing.T) {
+	for _, tc := range []struct {
+		expected, actual string
+		match            bool
+	}{
+		{"overwatch", "Overwatch", true},
+		{"overwatch.exe", "Overwatch.EXE", true},
+		{"Battle.net Helper", "battle.NET helper", true},
+		{"Игровой Клиент.exe", "игровой клиент.EXE", true},
+		{"VivoxVoiceService", "VIVOXVOICESERVICE", true},
+		{"Overwatch", "Overwatch Launcher", false},
+		{"Overwatch", "NotOverwatch", false},
+		{"Overwatch", "Overwatch.exe.bak", false},
+	} {
+		if got := equalWindowsProcessName(tc.expected, tc.actual); got != tc.match {
+			t.Errorf("%q / %q = %v, want %v", tc.expected, tc.actual, got, tc.match)
+		}
+	}
+}
+
+func TestLevikProcessSelection(t *testing.T) {
+	matcher := NewProcessNameMatcher([]string{"overwatch.exe", "VivoxVoiceService.exe", "Battle.net Helper.EXE"})
+	for _, name := range []string{"Overwatch", "VIVOXVOICESERVICE", "battle.net helper"} {
+		if got := processNamesContain(matcher.ProcessNames, name); got != (runtime.GOOS == "windows") {
+			t.Errorf("%q matched = %v on %s", name, got, runtime.GOOS)
+		}
+	}
+	if processNamesContain(matcher.ProcessNames, "Agent") || processNamesContain(nil, "Overwatch") {
+		t.Fatal("unselected process matched")
+	}
+	if !processNamesContain(matcher.ProcessNames, "overwatch") {
+		t.Fatal("exact executable match was lost")
+	}
+}
