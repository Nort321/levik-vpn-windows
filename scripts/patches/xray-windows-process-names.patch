@@ -0,0 +1,23 @@
+package router
+
+import (
+	"runtime"
+	"slices"
+	"strings"
+)
+
+// Windows executable identity is case-insensitive, including the extension.
+// Normalize at connection lookup time so saved selections work for processes
+// launched after the tunnel and for selections written by older clients.
+func equalWindowsProcessName(expected, actual string) bool {
+	return strings.EqualFold(strings.TrimSuffix(strings.ToLower(expected), ".exe"), strings.TrimSuffix(strings.ToLower(actual), ".exe"))
+}
+
+func processNamesContain(names []string, actual string) bool {
+	if runtime.GOOS != "windows" {
+		return slices.Contains(names, actual)
+	}
+	return slices.ContainsFunc(names, func(expected string) bool {
+		return equalWindowsProcessName(expected, actual)
+	})
+}
